# ==========================================================================
# AABHARAN / AURELIAN — Frontend Environment Variables
# Vite mein saari env variables "VITE_" prefix se shuru honi ZAROORI hai,
# warna woh frontend code mein accessible nahi hongi (import.meta.env.XXX)
# ==========================================================================

# ===== BACKEND API =====
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ===== FIREBASE (Phone OTP Authentication) =====
# Firebase Console -> Project Settings -> General -> Your apps -> SDK config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ===== RAZORPAY =====
# Sirf PUBLIC key id yaha aati hai (checkout widget kholne ke liye)
# Secret key kabhi frontend mein nahi aati — woh sirf backend .env mein rehti hai
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ===== CLOUDINARY (agar frontend se directly unsigned upload karna ho —
# jaise custom design reference image seedha browser se upload karwana) =====
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ===== APP CONFIG =====
VITE_APP_NAME=Klyra
VITE_ENV=development
